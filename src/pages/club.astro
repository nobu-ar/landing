---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar.jsx";
import { ClubSectionMain } from "../components/sections/Club/ClubSectionMain.jsx";
import { ClubSectionMiddle } from "../components/sections/Club/ClubSectionMiddle.jsx";
import { ClubSectionServices } from "../components/sections/Club/ClubSectionServices.jsx";
import { Footer } from "../components/Footer.jsx";
import { ScrollUpButton } from "../components/ScrollUpButton";

import "../styles/Theme.css";
import "../styles/Diagonals.css";
---

<Layout title="Nobu Clubes - Módulo diseñado para clubes, lleva al gestion de todos tus lugares, actividades y la administracion de tu club">
  <Navbar client:load />
  <ClubSectionMain client:load />
  <ClubSectionMiddle client:load />
  <ClubSectionServices client:load />
  <ScrollUpButton client:load />
  <Footer />
</Layout> 